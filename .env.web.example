# Copy to .env.web and fill in secrets locally. Never commit .env.web.
OPENAI_API_KEY=
# Set this to a model enabled for your OpenAI API project.
OPENAI_MODEL=

# Local development can read config.json if DATABASE_URL is omitted.
# On EC2, set DATABASE_URL instead of copying config.json.
DATABASE_URL=

# Directory containing original PDFs. PDFs are not included in this repo.
PDF_ROOT=data/pdfs

# Session cookies should be secure behind HTTPS on EC2.
COOKIE_SECURE=false
SESSION_HOURS=12
BGE_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# Number of source passages ultimately sent to the answer model.
RAG_FINAL_RESULTS=4
# Candidate passages requested from each search method before fusion and reranking.
RAG_CANDIDATES=24
# MMR relevance-versus-diversity balance: 1.0 favors relevance; 0.0 favors diversity.
RAG_MMR_LAMBDA=0.72
# Reciprocal Rank Fusion weight for BGE-M3 vector-search results.
RAG_VECTOR_WEIGHT=1.0
# Reciprocal Rank Fusion weight for exact PostgreSQL lexical-search results.
RAG_LEXICAL_WEIGHT=1.35
# Top lexical passages guaranteed a final source slot before MMR fills the remainder.
RAG_LEXICAL_RESERVED_SLOTS=1
# RRF rank constant; larger values reduce the difference between adjacent ranks.
RAG_RRF_K=60
# Add nearby chunks from the same document when context spans a chunk boundary.
RAG_NEIGHBOR_EXPANSION=true
# Only expand around this many of the strongest final retrieval results.
RAG_NEIGHBOR_TOP_RESULTS=2
# Include this many chunks before and after each expanded result.
RAG_NEIGHBOR_DISTANCE=1
# Hard cap after primary results, neighbors, and duplicate removal.
RAG_MAX_CONTEXT_CHUNKS=8
# Approximate maximum tokens used by retrieved document excerpts sent to OpenAI.
RAG_CONTEXT_TOKEN_BUDGET=2000

# Show admin-only timing and token diagnostics. Set false for a non-developer demo.
SHOW_DEVELOPER_ANALYTICS=true
