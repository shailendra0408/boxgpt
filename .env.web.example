# Copy to .env.web and fill in secrets locally. Never commit .env.web.
OPENAI_API_KEY=
# Set this to a model enabled for your OpenAI API project.
OPENAI_MODEL=

# Local development can read config.json if DATABASE_URL is omitted.
# On EC2, set DATABASE_URL instead of copying config.json.
DATABASE_URL=

# Directory containing original PDFs. PDFs are not included in this repo.
PDF_ROOT=data/pdfs

# Session cookies should be secure behind HTTPS on EC2.
COOKIE_SECURE=false
SESSION_HOURS=12
BGE_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
